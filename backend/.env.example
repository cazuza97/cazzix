PORT=3001
# Opcional: se quiser fixar a URL do Zabbix no servidor
# ZABBIX_URL=http://localhost:8080

# ─── GLPI Integration ────────────────────────────────────────────────────────
# URL base do GLPI (sem barra no final)
GLPI_URL=http://localhost/glpi
# App-Token: crie em Configuração > API geral > Adicionar app token
GLPI_APP_TOKEN=seu_app_token_aqui
# User Token: crie em Administração > Usuários > [usuário técnico] > Gerar token API
GLPI_USER_TOKEN=seu_user_token_aqui
